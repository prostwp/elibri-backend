bin/
*.exe
.env

# Binaries & build artifacts
*.dll
*.so
*.dylib
/elibri-backend
/server
/tmp/

# Tests & coverage
*.test
*.out
coverage.html

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# ML training artifacts — don't commit models/data (too big, regeneratable)
ml-training/.venv/
ml-training/data/*.parquet
ml-training/models/*_v*.json
ml-training/models/*_patterns.json
ml-training/logs/
ml-training/__pycache__/
ml-training/**/__pycache__/

# Keep "latest.json" pointer for reference
!ml-training/models/latest.json
!ml-training/models/latest_autogluon.json

# Stage 2 macro data + AutoGluon predictor dirs (regeneratable, multi-MB)
ml-training/data/macro/*.parquet
ml-training/models/ag_*/
ml-training/models/fusion_*/
ml-training/models/wfcv/

# Keep manifests for provenance/repro (small JSONs)
!ml-training/data/macro/manifest.json
!ml-training/data/regime_manifest_*.json

# Local model backups (safety copies, regeneratable from vast.ai)
ml-training/models.backup_*/
ml-training/models/*.bak.*
ml-training/models/*.patch*.bak.*
ml-training/models/*.bak_*
ml-training/models/latest.json.bak_*

# Python bot — local virtualenv + bytecode + secrets
telegram-bot/.venv/
telegram-bot/**/__pycache__/
telegram-bot/.env
telegram-bot/*.egg-info/

# Stray lockfile from npm install in wrong dir
package-lock.json

# Claude Flow metadata
.claude-flow/
.claude/

# Local env files & secrets (NEVER commit)
.env
.env.local
.env.*.local

# Telegram bot pattern indexes (binary numpy artefacts)
telegram-bot/data/pattern_indexes/
*.npy
